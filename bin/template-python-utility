#!/usr/bin/env python3
"""
template-python-utility - Python CLI utility template for sstix-tools.
"""

import argparse
import json
import os
import sys

__version__ = "0.1.0"
__tool_name__ = "template-python-utility"


def cmd_status(args):
    data = {
        "tool": __tool_name__,
        "version": __version__,
        "status": "operational",
        "python_version": sys.version.split()[0],
    }
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print(f"[{__tool_name__}] Status: OK (Python {data['python_version']})")
    return 0


def cmd_run(args):
    print(f"[{__tool_name__}] Executing task with option: {args.target or 'default'}")
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog=__tool_name__,
        description="Python CLI utility template for sstix-tools.",
    )
    parser.add_argument(
        "-v", "--version",
        action="version",
        version=f"%(prog)s {__version__}",
    )

    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # Status subcommand
    status_parser = subparsers.add_parser("status", help="Show utility status")
    status_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    # Run subcommand
    run_parser = subparsers.add_parser("run", help="Run the utility task")
    run_parser.add_argument("--target", type=str, help="Target for the task")

    args = parser.parse_args()

    if args.command == "status" or args.command is None:
        return cmd_status(args)
    elif args.command == "run":
        return cmd_run(args)
    else:
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
